# Copia questo file in .env.local e inserisci i dati del tuo progetto Supabase.
# La chiave è quella pubblica (publishable o anon): è fatta per stare nel browser,
# i dati sono protetti dal login e dalle regole della tabella.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
